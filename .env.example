# Shopify Storefront API (headless)
# Copy this file to `.env.local` and fill in your store values.
#
# In Shopify Admin:
# Settings → Apps and sales channels → Develop apps → Create an app
# → Configure Storefront API → Install → copy the public access token.
#
# Domain should be the myshopify.com hostname, without https://

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-token
SHOPIFY_STOREFRONT_API_VERSION=2026-01

# Optional. Server-only token with higher rate limits / extra fields.
# Never prefix this with NEXT_PUBLIC_.
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
