# Shopify Storefront API (headless)
# Copy this file to `.env.local` and fill in your store values.
#
# In Shopify Admin:
# Settings → Apps and sales channels → Develop apps → Create an app
# → Configure Storefront API → Install → copy the public access token.
#
# Token needs product + cart scopes, including:
# unauthenticated_read_product_listings
# unauthenticated_write_checkouts
# unauthenticated_read_checkouts
#
# Domain should be the myshopify.com hostname, without https://

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-public-storefront-token
SHOPIFY_STOREFRONT_API_VERSION=2026-01

# Optional. Server-only token with higher rate limits / extra fields.
# Never prefix this with NEXT_PUBLIC_.
# SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Shopify Customer Account API (headless login)
# Install the Headless sales channel, then:
# Settings → Customer accounts → enable Customer accounts
# Sales channels → Headless → Customer Account API
# Client type: Confidential (Next.js has a server)
# Copy Client ID and Client secret.
#
# Application setup (HTTPS only, no localhost):
# Callback URI:  https://YOUR_DOMAIN/api/auth/shopify/callback
# Javascript origin: https://YOUR_DOMAIN
# Logout URI: https://YOUR_DOMAIN
#
# Locally, Shopify rejects http://localhost. Use a tunnel (ngrok, Cloudflare)
# and set ORIGIN to that https URL.

SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-customer-account-client-id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=your-customer-account-client-secret
# SHOPIFY_CUSTOMER_ACCOUNT_ORIGIN=https://your-public-https-domain
